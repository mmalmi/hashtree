{
  "name": "@hashtree/nostr",
  "version": "0.2.1",
  "description": "Nostr integration for hashtree - ref resolver and event collections",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hashtree",
    "nostr",
    "resolver",
    "events",
    "merkle"
  ],
  "author": "Martti Malmi",
  "license": "MIT",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree/ts/packages/hashtree-nostr",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree?tab=issues"
  },
  "dependencies": {
    "@hashtree/collection": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.0/hashtree-collection-0.2.8.tgz",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.0/hashtree-core-0.3.0.tgz",
    "@hashtree/index": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.0/hashtree-index-0.1.12.tgz",
    "@msgpack/msgpack": "^3.1.2",
    "nostr-tools": "^2.18.2"
  },
  "devDependencies": {
    "@nostr-dev-kit/ndk": "^2.18.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
