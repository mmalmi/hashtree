{
  "name": "@hashtree/fips-transport",
  "version": "0.2.0",
  "description": "Hashtree mesh blob transport over opaque FIPS endpoint bytes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browserProvider.d.ts",
      "import": "./dist/browserProvider.js"
    },
    "./worker": {
      "types": "./dist/workerProvider.d.ts",
      "import": "./dist/workerProvider.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hashtree",
    "fips",
    "mesh",
    "transport"
  ],
  "author": "Martti Malmi",
  "license": "MIT",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree/ts/packages/hashtree-fips-transport",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree?tab=issues"
  },
  "dependencies": {
    "@fips/tcp": "github:mmalmi/fips-tcp#353cd0b9b723edd07b6cdc82c7e826d43b9a0d6e&path:ts",
    "@hashtree/core": "0.1.8",
    "@hashtree/mesh": "0.1.3"
  },
  "peerDependencies": {
    "@fips/core": ">=0.0.21",
    "@fips/transport-webrtc": ">=0.0.30"
  },
  "devDependencies": {
    "@fips/core": "file:../../vendor/fips/fips-core-0.0.21.tgz",
    "@fips/transport-webrtc": "file:../../vendor/fips/fips-transport-webrtc-0.0.30.tgz",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
