{
  "name": "@hashtree/dexie",
  "version": "0.1.7",
  "description": "Dexie-based IndexedDB store for hashtree",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hashtree",
    "dexie",
    "indexeddb",
    "storage"
  ],
  "author": "Martti Malmi",
  "license": "MIT",
