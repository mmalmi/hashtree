{
  "name": "@hashtree/worker",
  "version": "0.4.6",
  "description": "Modular browser worker for hashtree blob caching, tree-root state, and Blossom connectivity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./relay-client": {
      "types": "./dist/relay-client.d.ts",
      "import": "./dist/relay-client.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./relay-entry": {
      "types": "./dist/relay-entry.d.ts",
      "import": "./dist/relay-entry.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./htree-url": {
      "types": "./dist/htree-url.d.ts",
      "import": "./dist/htree-url.js"
    },
    "./htree-path": {
      "types": "./dist/htree-path.d.ts",
      "import": "./dist/htree-path.js"
    },
    "./tree-root": {
      "types": "./dist/tree-root.d.ts",
      "import": "./dist/tree-root.js"
    },
    "./nostr-source-port": {
      "types": "./dist/nostrSourcePort.d.ts",
      "import": "./dist/nostrSourcePort.js"
    },
    "./event-store": {
      "types": "./dist/relay/eventIndex.d.ts",
      "import": "./dist/relay/eventIndex.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hashtree",
    "worker",
    "indexeddb",
    "blossom"
  ],
  "author": "Martti Malmi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree"
  },
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree/ts/packages/hashtree-worker",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree?tab=issues"
  },
  "dependencies": {
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-core-0.3.2.tgz",
    "@hashtree/dexie": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-dexie-0.1.11.tgz",
    "@hashtree/mesh": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-mesh-0.3.2.tgz",
    "@hashtree/nostr": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.9/hashtree-nostr-0.2.5.tgz",
    "@msgpack/msgpack": "^3.1.2",
    "dexie": "4.4.2",
    "nostr-tools": "^2.23.3",
    "nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.5.12/nostr-pubsub-0.5.12.tgz",
    "@hashtree/nostr-pubsub": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.10/hashtree-nostr-pubsub-0.1.6.tgz"
  },
  "peerDependencies": {
    "nostr-social-graph": "*"
  },
  "peerDependenciesMeta": {
    "nostr-social-graph": {
      "optional": true
    }
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "nostr-social-graph": "https://github.com/mmalmi/nostr-social-graph/releases/download/v2.0.0/nostr-social-graph-2.0.0.tgz",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
