{
  "name": "@hashtree/worker",
  "version": "0.2.15",
  "description": "Modular browser worker for hashtree blob caching, tree-root state, and Blossom connectivity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./relay-client": {
      "types": "./dist/relay-client.d.ts",
      "import": "./dist/relay-client.js"
    },
    "./p2p": {
      "types": "./dist/p2p/index.d.ts",
      "import": "./dist/p2p/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./relay-entry": {
      "types": "./dist/relay-entry.d.ts",
      "import": "./dist/relay-entry.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./htree-url": {
      "types": "./dist/htree-url.d.ts",
      "import": "./dist/htree-url.js"
    },
    "./htree-path": {
      "types": "./dist/htree-path.d.ts",
      "import": "./dist/htree-path.js"
    },
    "./tree-root": {
      "types": "./dist/tree-root.d.ts",
      "import": "./dist/tree-root.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "hashtree",
    "worker",
    "indexeddb",
    "blossom"
  ],
  "author": "Martti Malmi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree"
  },
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree/ts/packages/hashtree-worker",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree?tab=issues"
  },
  "dependencies": {
    "@hashtree/core": "0.1.6",
    "@hashtree/dexie": "0.1.5",
    "@hashtree/mesh": "workspace:*",
    "@hashtree/nostr": "workspace:*",
    "@msgpack/msgpack": "^3.1.2",
    "dexie": "^4.2.1",
    "nostr-tools": "^2.18.2"
  },
  "peerDependencies": {
    "ndk": "*",
    "ndk-cache": "*",
    "nostr-social-graph": "*"
  },
  "peerDependenciesMeta": {
    "ndk": {
      "optional": true
    },
    "ndk-cache": {
      "optional": true
    },
    "nostr-social-graph": {
      "optional": true
    }
  },
  "devDependencies": {
    "ndk": "workspace:*",
    "ndk-cache": "workspace:*",
    "nostr-social-graph": "workspace:*",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
