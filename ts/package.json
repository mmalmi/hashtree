{
  "name": "hashtree-monorepo",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HashTree monorepo",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree/ts",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree?tab=issues"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@fips/core": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.42/fips-core-0.0.42.tgz",
      "@fips/tcp": "https://github.com/mmalmi/fips-tcp/releases/download/v0.2.0/fips-tcp-0.2.0.tgz",
      "@fips/transport-webrtc": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.29/fips-transport-webrtc-0.0.45.tgz",
      "@fips/transport-websocket": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.29/fips-transport-websocket-0.0.3.tgz",
      "@hashtree/collection": "link:packages/hashtree-collection",
      "@hashtree/core": "link:packages/hashtree",
      "@hashtree/dexie": "link:packages/hashtree-dexie",
      "@hashtree/git": "link:packages/hashtree-git",
      "@hashtree/index": "link:packages/hashtree-index",
      "@hashtree/mesh": "link:packages/hashtree-mesh",
      "@hashtree/nostr": "link:packages/hashtree-nostr",
      "@hashtree/nostr-pubsub": "link:packages/hashtree-nostr-pubsub",
      "@hashtree/worker": "link:packages/hashtree-worker",
      "serialize-javascript": "7.0.7"
    }
  },
  "scripts": {
    "build": "pnpm run build:hashtree",
    "build:hashtree": "pnpm --filter @hashtree/core build",
    "test": "node --test scripts/*.test.mjs && pnpm --filter @hashtree/core test",
    "test:watch": "pnpm --filter @hashtree/core test:watch",
    "lint": "eslint packages/hashtree/src",
    "lint:fix": "eslint packages/hashtree/src --fix",
    "verify:nostr-pubsub": "pnpm --filter @hashtree/nostr-pubsub check && pnpm --filter @hashtree/nostr-pubsub test && pnpm --filter @hashtree/nostr-pubsub build",
    "verify:fips-transport": "pnpm --filter @hashtree/fips-transport... build && pnpm --filter @hashtree/fips-transport verify:dist && pnpm --filter @hashtree/fips-transport test && pnpm --filter @hashtree/fips-transport lint",
    "maps:crawl": "pnpm --filter @hashtree/core build && node scripts/maps/crawl-tiles.js",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "publish:packages": "bash ./scripts/publish.sh",
    "publish:packages:dry-run": "bash ./scripts/publish.sh --dry-run",
    "publish:packages:plan": "bash ./scripts/publish.sh --plan"
  },
  "devDependencies": {
    "@esbuild/linux-arm64": "^0.28.1",
    "@playwright/test": "^1.61.1",
    "@rollup/rollup-linux-arm64-gnu": "^4.62.2",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "nostr-tools": "^2.18.2",
    "typescript": "^5.3.0",
    "ws": "^8.21.1"
  }
}
