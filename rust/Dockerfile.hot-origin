# syntax=docker/dockerfile:1.7

# Build with a context containing these sibling directories:
#   hashtree-rust/   this repository's rust/ directory
#   cashu-service/   build-time Cashu helper dependency
#   fips/            build-time FIPS dependency
#
# Example:
#   docker build -f hashtree-rust/Dockerfile.hot-origin -t iris-backend-htree:local-nos3 .
#
# The runtime image is still a local-fileserver hashtree daemon. It does not
# enable S3/R2 support.

FROM rust:1.95-bookworm AS builder
ARG BUILD_CASHU=0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        clang \
        libclang-dev \
        libdbus-1-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY hashtree-rust/Cargo.toml hashtree-rust/Cargo.lock ./
COPY hashtree-rust/vendor ./vendor
COPY hashtree-rust/crates ./crates
COPY cashu-service /cashu-service
COPY fips /fips

RUN --mount=type=cache,id=hashtree-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=hashtree-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=hashtree-target,target=/app/target,sharing=locked \
    cargo build --locked --release --package hashtree-cli && \
    if [ "$BUILD_CASHU" = "1" ]; then \
        cargo build --locked --release --package hashtree-cashu-cli; \
    fi && \
    mkdir -p /out && \
    cp /app/target/release/htree /out/htree && \
    if [ "$BUILD_CASHU" = "1" ]; then \
        cp /app/target/release/htree-cashu /out/htree-cashu; \
    fi

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libdbus-1-3 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/htree /usr/local/bin/htree

WORKDIR /data

EXPOSE 8080

CMD ["htree", "start", "--addr", "0.0.0.0:8080", "--data-dir", "/data"]
