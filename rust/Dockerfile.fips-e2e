# syntax=docker/dockerfile:1.7

ARG RUST_IMAGE=rust:1.94.1-bookworm

FROM ${RUST_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        libclang-dev \
        libdbus-1-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work/hashtree/rust
COPY --from=hashtree-rust / /work/hashtree/rust
COPY --from=fips / /work/fips

RUN --mount=type=cache,id=htree-fips-e2e-cargo-registry,sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=htree-fips-e2e-cargo-git,sharing=locked,target=/usr/local/cargo/git \
    --mount=type=cache,id=htree-fips-e2e-target,sharing=locked,target=/target-dir \
    set -eux; \
    CARGO_TARGET_DIR=/target-dir cargo build --locked -p hashtree-cli --bin htree --bin nostr-relay-smoke; \
    mkdir -p /out; \
    cp /target-dir/debug/htree /target-dir/debug/nostr-relay-smoke /out/

FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl jq bash libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/htree /usr/local/bin/htree
COPY --from=builder /out/nostr-relay-smoke /usr/local/bin/nostr-relay-smoke

WORKDIR /data
